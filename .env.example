# Apify
APIFY_TOKEN=your_apify_token_here

# AI Scoring — set at least one. Groq is free (no billing needed).
# Auto-detects priority: groq > gemini > claude
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# SCORER_BACKEND=auto  # "auto", "groq", "gemini", or "claude"

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_automation

# Naukri credentials (for Playwright login)
NAUKRI_EMAIL=your_naukri_email
NAUKRI_PASSWORD=your_naukri_password

# Workday credentials — one EMAIL/PASSWORD pair per employer key in
# config.WORKDAY_EMPLOYERS, named WORKDAY_<KEY>_EMAIL / _PASSWORD.
WORKDAY_MASTERCARD_EMAIL=your_mastercard_workday_email
WORKDAY_MASTERCARD_PASSWORD=your_mastercard_workday_password
