# Apify
APIFY_TOKEN=your_apify_token_here

# AI Scoring — set at least one. Gemini is free (1000 req/day).
# Auto-detects: uses Gemini if GEMINI_API_KEY is set, else Claude.
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# SCORER_BACKEND=auto  # "auto", "gemini", or "claude"

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_automation

# Naukri credentials (for Playwright login)
NAUKRI_EMAIL=your_naukri_email
NAUKRI_PASSWORD=your_naukri_password
